ARG BUILD_VERSION=dev
# ARG BASEIMGTYPE=docker

# 使用兼容 armv7 的基础镜像
# FROM debian:12.2-slim AS base
FROM ghcr.io/home-assistant/armv7-base-debian:latest AS base

ARG TARGETARCH
ARG TARGETVARIANT

# 安装构建依赖
RUN \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-pip \
        python3-setuptools \
        python3-venv \
        python3-wheel \
        iputils-ping \
        git \
        curl \
        openssh-client \
        python3-cffi \
        libcairo2 \
        libmagic1 \
        patch \
        build-essential \
        python3-dev \
        libffi-dev \
        libssl-dev \
        cargo \
        pkg-config \
        libjpeg-dev \
        zlib1g-dev \
        libtiff6 \
        libfreetype-dev \
        libopenjp2-7 && \
    rm -rf /var/lib/apt/lists/*

# 修复 git 安全目录警告
RUN git config --system --add safe.directory '*'

# armv7 平台修复 ld-linux 链接问题
RUN if [ "$TARGETARCH$TARGETVARIANT" = "armv7" ]; then \
      ln -s /lib/arm-linux-gnueabihf/ld-linux-armhf.so.3 /lib/ld-linux.so.3 || true; \
    fi

# 设置语言环境
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    PLATFORMIO_GLOBALLIB_DIR=/piolibs

# 设置 piwheels 镜像用于加速 armv7 架构的 pip 安装
RUN if [ "$TARGETARCH$TARGETVARIANT" = "armv7" ]; then \
      export PIP_EXTRA_INDEX_URL="https://www.piwheels.org/simple"; \
    fi && \
    pip3 install --break-system-packages --no-cache-dir platformio==6.1.16

# platformio 设置
RUN \
    platformio settings set enable_telemetry No && \
    platformio settings set check_platformio_interval 1000000 && \
    mkdir -p /piolibs

# 拷贝 requirements 文件
COPY requirements.txt requirements_optional.txt /
COPY script/platformio_install_deps.py platformio.ini /

# 安装 Python 依赖（优先使用 piwheels）
RUN if [ "$TARGETARCH$TARGETVARIANT" = "armv7" ]; then \
      export PIP_EXTRA_INDEX_URL="https://www.piwheels.org/simple"; \
    fi && \
    pip3 install --break-system-packages --no-cache-dir -r /requirements.txt -r /requirements_optional.txt

# 安装 platformio 库依赖
RUN /platformio_install_deps.py /platformio.ini --libraries

LABEL \
    org.opencontainers.image.authors="The ESPHome Authors" \
    org.opencontainers.image.title="ESPHome" \
    org.opencontainers.image.description="ESPHome is a system to configure your microcontrollers by simple yet powerful configuration files and control them remotely through Home Automation systems" \
    org.opencontainers.image.url="https://esphome.io/" \
    org.opencontainers.image.documentation="https://esphome.io/" \
    org.opencontainers.image.source="https://github.com/esphome/esphome" \
    org.opencontainers.image.licenses="ESPHome" \
    org.opencontainers.image.version=${BUILD_VERSION}


# ==================== 最终镜像 ====================
FROM base AS final

# 拷贝 esphome 源码
COPY . /esphome

# 安装 esphome（editable 模式）
RUN if [ "$TARGETARCH$TARGETVARIANT" = "armv7" ]; then \
      export PIP_EXTRA_INDEX_URL="https://www.piwheels.org/simple"; \
    fi && \
    pip3 install --break-system-packages --no-cache-dir -e /esphome

# 暴露端口
EXPOSE 6052

# 健康检查
HEALTHCHECK --interval=30s --timeout=30s \
  CMD curl --fail http://localhost:6052/version -A "HealthCheck" || exit 1

# 拷贝入口脚本
COPY docker/docker_entrypoint.sh /entrypoint.sh

# 设置工作目录和挂载卷
VOLUME /config
WORKDIR /config


# 启动 dashboard
ENTRYPOINT ["/entrypoint.sh"]
CMD ["dashboard", "/config"]

